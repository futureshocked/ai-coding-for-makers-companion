FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql://localhost/makerspace
TEST_DATABASE_URL=postgresql://localhost/makerspace_test
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@makerspace.example.com
REMINDER_INTERVAL_HOURS=1
REMINDER_HOURS_BEFORE=24
NAGER_DATE_COUNTRY=AU

# Baked into the Docker image at build time. Leave as "dev" locally.
APP_VERSION=dev

# In dev, leave unset (defaults to "1" so the in-process scheduler runs).
# In production, both `app` and `scheduler` Docker services set RUN_SCHEDULER=0;
# the scheduler container runs `python -m app.scheduler` as its own process.
# RUN_SCHEDULER=1

# Cloudflare API token for wildcard TLS (DNS-01 challenge). Required in production.
CLOUDFLARE_API_TOKEN=
